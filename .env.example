# Keep collection closed until the database and public notice are ready.
WAITLIST_ENABLED=false
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
WAITLIST_RETENTION_DAYS=
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store the result only in .env.local / deployment secrets, never in source or chat.
WAITLIST_TOKEN_SECRET=
# Leave blank unless the deployment has been verified to overwrite this header.
# Allowed: x-real-ip, x-forwarded-for, cf-connecting-ip. One bare IP only.
WAITLIST_TRUSTED_IP_HEADER=
# All mail settings are required before real collection enables. Use a verified bare sender address.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
WAITLIST_EMAIL_FROM=
CRON_SECRET=
WAITLIST_DAILY_SEND_BUDGET=
WAITLIST_PENDING_RETENTION_DAYS=7
# Disable provider open/click tracking in Resend. Never paste secrets into chat.

# Optional public inbox: enables a user-reviewed email draft, not an automatic submission.
PARTNERS_CONTACT_EMAIL=
