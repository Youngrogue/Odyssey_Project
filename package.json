{
  "name": "odyssey-project-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --no-file-parallelism --testTimeout=30000",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "setup:check": "node --env-file-if-exists=.env.local scripts/check-setup.mjs",
    "cf:build": "node scripts/cloudflare-build.mjs",
    "cf:preview": "wrangler dev --local --port 43219 --ip 127.0.0.1",
    "test:worker": "node scripts/test-worker.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.12",
    "next": "16.4.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.2",
    "wrangler": "4.151.1"
  },
  "packageManager": "pnpm@11.20.0"
}
